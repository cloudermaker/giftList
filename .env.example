# Copy to .env.local and fill in — real values are NEVER committed.

# Neon/Vercel Postgres connection string (used by prisma/schema.prisma)
POSTGRES_PRISMA_URL="postgres://user:password@host/db?sslmode=require"

# MailerSend SMTP (contact form, pages/api/sendEmail.ts)
MAILERSEND_SMTP_USERNAME=""
MAILERSEND_SMTP_PASSWORD=""

# Backoffice credentials (pages/api/backoffice/auth.ts)
BACKOFFICE_USERNAME=""
BACKOFFICE_PASSWORD=""

# Maintenance mode: set to "true" to redirect the whole site to /maintenance
MAINTENANCE_MODE="false"
