{
    "name": "gift_list",
    "version": "5.2.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "postbuild": "next-sitemap",
        "start": "next start",
        "lint": "next lint",
        "format": "prettier --loglevel warn --write .",
        "test:e2e": "playwright test",
        "postinstall": "prisma generate",
        "maintenance:on": "echo MAINTENANCE_MODE=true >> .env.local",
        "maintenance:off": "powershell -Command \"(Get-Content .env.local) | Where-Object { $_ -notmatch 'MAINTENANCE_MODE' } | Set-Content .env.local\""
    },
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.1.0",
        "@dnd-kit/sortable": "^8.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@prisma/client": "^5.22.0",
        "@types/node": "^24.6.2",
        "@types/nodemailer": "^7.0.2",
        "@typescript-eslint/eslint-plugin": "^6.9.0",
        "@typescript-eslint/parser": "^6.9.0",
        "@vercel/analytics": "^1.5.0",
        "@vercel/speed-insights": "^2.0.0",
        "axios": "^1.18.0",
        "js-cookie": "^3.0.7",
        "next": "^15.5.25",
        "nodemailer": "^9.1.1",
        "nprogress": "^0.2.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-spinners": "^0.13.7",
        "sweetalert2": "^11.23.0",
        "typescript": "^5.2.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/js-cookie": "^3.0.2",
        "@types/nprogress": "^0.2.0",
        "@types/react": "18.0.26",
        "@types/react-dom": "18.0.9",
        "autoprefixer": "^10.4.13",
        "dotenv": "^17.4.2",
        "eslint": "^8.52.0",
        "eslint-config-next": "^15.5.7",
        "eslint-config-prettier": "^9.0.0",
        "next-sitemap": "^4.2.3",
        "prettier": "^3.0.3",
        "prisma": "^5.22.0",
        "tailwindcss": "^3.3.5"
    }
}
