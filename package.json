{
    "name": "gift_list",
    "version": "5.9.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "postbuild": "next-sitemap",
        "start": "next start",
        "lint": "eslint .",
        "format": "prettier --loglevel warn --write .",
        "test:e2e": "playwright test",
        "postinstall": "prisma generate",
        "maintenance:on": "echo MAINTENANCE_MODE=true >> .env.local",
        "maintenance:off": "powershell -Command \"(Get-Content .env.local) | Where-Object { $_ -notmatch 'MAINTENANCE_MODE' } | Set-Content .env.local\""
    },
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.1.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@prisma/client": "^5.22.0",
        "@types/node": "^24.6.2",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "axios": "^1.18.0",
        "js-cookie": "^3.0.7",
        "lucide-react": "^1.61.0",
        "next": "16.4.3",
        "nodemailer": "^10.1.1",
        "nprogress": "^0.2.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-spinners": "^0.17.1",
        "sweetalert2": "^11.23.0",
        "typescript": "^5.2.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@emnapi/core": "1.11.3",
        "@emnapi/runtime": "1.11.3",
        "@eslint/eslintrc": "^3.3.7",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/js-cookie": "^3.0.2",
        "@types/nodemailer": "^8.0.2",
        "@types/nprogress": "^0.2.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "dotenv": "^18.0.9",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.3",
        "next-sitemap": "^4.2.3",
        "prettier": "^3.0.3",
        "prisma": "^5.22.0",
        "tailwindcss": "^4.3.3"
    }
}
